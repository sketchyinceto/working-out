{
  "name": "apex-workout-tracker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "diet-sync": "esbuild scripts/diet-sync.ts --bundle --platform=node --format=esm --packages=external --log-level=warning --outfile=node_modules/.cache/diet-sync.mjs && node node_modules/.cache/diet-sync.mjs"
  },
  "dependencies": {
    "lucide-react": "0.475.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.4",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "tailwindcss": "4.3.4",
    "typescript": "5.8.3",
    "vite": "6.4.5"
  }
}
